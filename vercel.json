{
  "version": 2,
  "builds": [
    {
      "src": "server/app_handler.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**/*",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/api/(.*)",
      "destination": "/server/app_handler.py"
    },
    {
      "source": "/(.*)",
      "destination": "/public/$1"
    }
  ]
}
