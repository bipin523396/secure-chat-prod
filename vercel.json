{
  "version": 2,
  "builds": [
    {
      "src": "backend-v3/main.py",
      "use": "@vercel/python"
    },
    {
      "src": "public/**",
      "use": "@vercel/static"
    }
  ],
  "rewrites": [
    {
      "source": "/v3-api/(.*)",
      "destination": "backend-v3/main.py"
    },
    {
      "source": "/(.*)",
      "destination": "public/$1"
    }
  ]
}
