{
  "version": 2,
  "headers": [
    {
      "source": "/(.*\\.html|/)$",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" }
      ]
    },
    {
      "source": "/(js|css)/(.+)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ],
  "rewrites": [
    {
      "source": "/favicon.ico",
      "destination": "/favicon.svg"
    },
    {
      "source": "/api/:path*",
      "destination": "https://secure-chat-prod.onrender.com/api/:path*"
    }
  ]
}
